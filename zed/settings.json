// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "off",
  "scrollbar": {
    "show": "always",
  },
  "ssh_connections": [
    {
      "host": "gabedev2",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu/dev/api-sanctum"],
        },
        {
          "paths": ["/home/ubuntu/dev/app-nestment"],
        },
        {
          "paths": ["/home/ubuntu/dev/notes"],
        },
      ],
    },
  ],
  "use_system_window_tabs": true,
  "tabs": {
    "file_icons": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true,
  },
  "icon_theme": "Catppuccin Frappé",
  "ui_font_weight": 300.0,
  "ui_font_family": "Helvetica Neue",
  "indent_guides": {
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "vertical_scroll_margin": 4.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Share Tech Mono",
  "terminal": {
    "keep_selection_on_copy": false,
    "font_family": "Cascadia Mono",
    "font_size": 16,
    "line_height": {
      "custom": 1.2,
    },
    "font_weight": 300,
  },
  "agent": {
    "play_sound_when_agent_done": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "disabled",
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Synthwave Alpha",
    // "dark": "Gruvbox Dark Hard",
  },

  "experimental.theme_overrides": {
    "terminal.background": "#241541",
    "terminal.foreground": "#64ffff",
    "terminal.ansi.background": "#241541",
    "terminal.ansi.black": "#170a2f",
    "terminal.ansi.bright_black": "#515151",
    "terminal.ansi.red": "#eb3dac",
    "terminal.ansi.bright_red": "#fd1d53",
    "terminal.ansi.green": "#d288f5",
    "terminal.ansi.bright_green": "#fab0ff",
    "terminal.ansi.yellow": "#f9c80e",
    "terminal.ansi.bright_yellow": "#fd9f52",
    "terminal.ansi.blue": "#147eb8",
    "terminal.ansi.bright_blue": "#3ca6e0",
    "terminal.ansi.magenta": "#775abb",
    "terminal.ansi.bright_magenta": "#9f82e3",
    "terminal.ansi.cyan": "#246e83",
    "terminal.ansi.bright_cyan": "#19ced2",
    "terminal.ansi.white": "#64ffff",
    "terminal.ansi.bright_white": "#ffffff",
    "players": [
      {
        "selection": "#f9c80e",
        "cursor": "#fd9f52",
        // "background": "#241541",
      },
    ],
    "syntax": {
      "comment": {
        "color": "#515151",
      },
    },
    "hint": "#515151",
  },
}
