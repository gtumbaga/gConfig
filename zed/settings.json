// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "languages": {
    "PHP": {
      "language_servers": [
        "!phpactor",
        "intelephense"
      ]
    }
  },
  "unnecessary_code_fade": 0.7,
  "semantic_tokens": "combined",
  "diagnostics": {
     "inline": {
       "enabled": true,
       "max_severity": "warning"
     }
   },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "format_on_save": "off",
  "scrollbar": {
    "show": "always",
    "diagnostics": "all"
  },
  "ssh_connections": [
    {
      "host": "gabedev2",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ubuntu/dev/api-sanctum"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/app-nestment"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/app2"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/gc-eks"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/gcloud"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/notes"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/umd-nestment"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/dev/webflow"
          ]
        },
        {
          "paths": [
            "/home/ubuntu/openwebui"
          ]
        }
      ]
    },
    {
      "host": "gabedev",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/gtumbaga/dev/api-sanctum"
          ]
        },
        {
          "paths": [
            "/home/gtumbaga/dev/app-nestment"
          ]
        }
      ]
    }
  ],
  "use_system_window_tabs": true,
  "tabs": {
    "file_icons": true,
    // "show_diagnostics": "all"
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
  },
  "icon_theme": "Catppuccin Frappé",
  "ui_font_weight": 300.0,
  "ui_font_family": "Helvetica Neue",
  "indent_guides": {
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "vertical_scroll_margin": 4.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "buffer_line_height": "standard",
  "buffer_font_weight": 200.0,
  "buffer_font_family": "Cascadia Mono",
  "terminal": {
    "shell": "system",
    "bell": "system",
    "keep_selection_on_copy": false,
    "font_family": "Cascadia Mono",
    "font_size": 16,
    "line_height": {
      "custom": 1.2,
    },
    "font_weight": 200,
  },
  "agent": {
    "dock": "right",
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-5",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim": {
    "use_system_clipboard": "never",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "disabled",
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Synthwave Alpha",
  },

  "experimental.theme_overrides": {
    "terminal.background": "#241541",
    "terminal.foreground": "#64ffff",
    "terminal.ansi.background": "#241541",
    "terminal.ansi.black": "#170a2f",
    "terminal.ansi.bright_black": "#515151",
    "terminal.ansi.red": "#eb3dac",
    "terminal.ansi.bright_red": "#fd1d53",
    "terminal.ansi.green": "#d288f5",
    "terminal.ansi.bright_green": "#fab0ff",
    "terminal.ansi.yellow": "#f9c80e",
    "terminal.ansi.bright_yellow": "#fd9f52",
    "terminal.ansi.blue": "#147eb8",
    "terminal.ansi.bright_blue": "#3ca6e0",
    "terminal.ansi.magenta": "#775abb",
    "terminal.ansi.bright_magenta": "#9f82e3",
    "terminal.ansi.cyan": "#246e83",
    "terminal.ansi.bright_cyan": "#19ced2",
    "terminal.ansi.white": "#64ffff",
    "terminal.ansi.bright_white": "#ffffff",
    "players": [
      {
        "selection": "#f9c80e",
        "cursor": "#fd9f52",
      },
    ],
    "syntax": {
      "comment": {
        "color": "#515151",
      },
    },
    "hint": "#515151",
  },
}
