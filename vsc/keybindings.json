// Place your key bindings in this file to override the defaults
[
    // Move down to terminal from editor OR file explorer
    {
        "key": "ctrl+w j",
        "command": "workbench.action.terminal.focus",
        "when": "editorTextFocus || filesExplorerFocus"
    },
    // If ALREADY in terminal: expand / maximize the terminal panel
    {
        "key": "ctrl+w j",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+w j",
        "command": "workbench.action.terminal.focus",
        "when": "!editorTextFocus && !terminalFocus && !sideBarVisible"
    },
    // If in terminal: focus back up to active editor
    {
        "key": "ctrl+w k",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus"
    },
    // If in editor: hide/close the terminal panel
    {
        "key": "ctrl+w k",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.closePanel",
                "workbench.action.closeSidebar",
                "workbench.action.closeAuxiliaryBar",
            ]
        },
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+w h",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "(editorTextFocus || terminalFocus)"
    },
    {
        "key": "ctrl+w h",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "!editorTextFocus && !terminalFocus && !sideBarFocus"
    },
    // Move focus from File Explorer back to editor
    {
        "key": "ctrl+w l",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "sideBarFocus"
    },
    {
        "key": "ctrl+w w",
        "command": "workbench.action.switchWindow"
    },
    {
        "key": "ctrl+w l",
        // "command": "claude-dev.SidebarProvider.focus",
        // "command": "cline.focusChatInput",
        "command": "workbench.action.focusAuxiliaryBar",
        "when": "(editorTextFocus || terminalFocus) && !sideBarFocus"
    },
    // Horizontal page scroll. editorScroll has no horizontal "page" unit,
    // only columns, so value is an approximate viewport width.
    {
        "key": "ctrl+h",
        "command": "editorScroll",
        "when": "editorTextFocus",
        "args": {
            "to": "left",
            "by": "column",
            "value": 40,
            "revealCursor": false
        }
    },
    {
        "key": "ctrl+l",
        "command": "editorScroll",
        "when": "editorTextFocus",
        "args": {
            "to": "right",
            "by": "column",
            "value": 40,
            "revealCursor": false
        }
    },
    // \ space c — comment the current line, or every line in the selection
    {
        "key": "\\ c space",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    }
]